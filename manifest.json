{
  "manifest_version": 3,
  "name": "NotbadBookmark",
  "version": "1.1.4",
  "description": "A fast, private bookmark manager with folders, tags, drag-and-drop, search, import/export, and dark mode.",
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "action": {
    "default_title": "Open NotbadBookmark Manager"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "chrome_url_overrides": {
    "bookmarks": "bookmarks.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
